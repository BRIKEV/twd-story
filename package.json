{
  "name": "twd-story",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm sw && vp dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vp preview",
    "build-only": "pnpm sw && vp build",
    "type-check": "vue-tsc --build",
    "format": "vp fmt src/",
    "prepare": "vp config",
    "sw": "twd-js init public",
    "test:ci": "twd-cli run",
    "dev:ci": "pnpm sw && CI=true vp dev",
    "collect:coverage:text": "nyc report --reporter=text --temp-dir .nyc_output --extension .ts --extension .vue",
    "collect:coverage:html": "nyc report --reporter=html --temp-dir .nyc_output --extension .ts --extension .vue",
    "collect:coverage:lcov": "nyc report --reporter=lcov --temp-dir .nyc_output --extension .ts --extension .vue"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "twd-js": "^1.12.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.3",
    "nyc": "^18.0.0",
    "twd-cli": "^1.11.0",
    "twd-lint": "^1.0.0",
    "typescript": "~6.0.0",
    "vite": "catalog:",
    "vite-plugin-istanbul": "^9.0.1",
    "vite-plus": "catalog:",
    "vue-tsc": "^3.3.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
